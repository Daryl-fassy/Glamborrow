<script id="wd-sticky-column-js" src="./img261_files/stickyColumn.min.js.download"></script><div id="payflex-modal" style="font-family: &#39;Open Sans&#39;, sans-serif;">
    <div class="pf-modal-box">
        <div class="pf-modal-header">
            <button class="payflex-button-close">
                <img src="data:image/png;base64," alt="Close">
            </button>
            <div class="pf-header-row">
                <img class="pf-header-logo" src="data:image/png;base64," alt="Payflex">
                <div class="pf-tagline">
                    <span class="pf-purple pf-bold">NO INTEREST.<br> NO FEES.</span><br>
                    <span class="pf-navy pf-bold"><em>THIS</em> IS SHOPPING.</span>
                </div>
            </div>
        </div>
        <hr class="pf-divider">
        <div class="pf-steps">
            <div class="pf-step">
                <div class="pf-step-num">1</div>
                <div class="pf-step-body">
                    <div class="pf-step-heading pf-purple">SELECT YOUR PAYMENT PLAN</div>
                    <p class="pf-step-desc">2, 3 OR 4 INSTALMENTS</p>
                </div>
            </div>
            <div class="pf-step">
                <div class="pf-step-num">2</div>
                <div class="pf-step-body">
                    <div class="pf-step-heading pf-purple">PAY IN 2</div>
                    <p class="pf-step-desc">PAY HALF UPFRONT AND THE REST ON YOUR NEXT PAYDAY - INTEREST FREE</p>
                    <div class="pf-step-heading pf-purple">PAY IN 3</div>
                    <p class="pf-step-desc">PAY OVER 3 PAYDAYS - INTEREST FREE</p>
                    <div class="pf-step-heading pf-purple">PAY IN 4</div>
                    <p class="pf-step-desc">PAY IN 4 INSTALMENTS OVER 6 WEEKS - INTEREST FREE</p>
                </div>
            </div>
            <div class="pf-step">
                <div class="pf-step-num">3</div>
                <div class="pf-step-body">
                    <div class="pf-step-heading pf-purple">FLEX! GET APPROVED</div>
                    <p class="pf-step-desc">PAY YOUR FIRST INSTALLMENT TODAY AND GET WHAT YOU WANT NOW</p>
                </div>
            </div>
        </div>
        <hr class="pf-divider">
        <div class="pf-legal">
            <div class="pf-legal-item">
                <img src="data:image/svg+xml;base64," alt="">
                <span>You must be over 18 years old</span>
            </div>
            <div class="pf-legal-item">
                <img src="data:image/svg+xml;base64," alt="">
                <span>You must have a valid South African ID</span>
            </div>
            <div class="pf-legal-item">
                <img src="data:image/svg+xml;base64," alt="">
                <span>You must have a debit/credit card issued by Mastercard, Visa or Amex</span>
            </div>
        </div>
        <hr class="pf-divider">
        <div class="pf-footer">
            <span class="pf-purple pf-bold">Still want more information?</span>&nbsp;
            <a href="https://www.payflex.co.za/" target="_blank" class="pf-navy pf-bold">Click here</a>
        </div>
    </div>
</div>
