c parties\r\n- Crafted for all-day comfort with cushioned insoles\r\n- Elegant finishes and classic design details\r\n- Versatile enough for both dressy and smart-casual looks\r\n- Built to last with durable, high-quality materials\r\n\r\nStep up your style - choose Belem.","image":"https://parktownstores.co.za/wp-content/uploads/2025/07/41351.jpg","sku":"41351","offers":[{"@type":"Offer","priceSpecification":[{"@type":"UnitPriceSpecification","price":"399.00","priceCurrency":"ZAR","validThrough":"2027-12-31"}],"priceValidUntil":"2027-12-31","availability":"https://schema.org/InStock","url":"https://parktownstores.co.za/product/belem-5500-2-shoe/","seller":{"@type":"Organization","name":"Parktown Stores","url":"https://parktownstores.co.za"},"price":"399.00","priceCurrency":"ZAR"}]}]}</script><div class="wpc-filters-overlay"></div>
