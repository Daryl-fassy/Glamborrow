}

.payflex-w-full {
    width: 100%;
}

.payflex-flex-row {
    flex-direction: row;
}

.payflex-text-left {
    text-align: left;
}

.payflex-text-center {
    text-align: center;
}

.payflex-font-bold {
    font-weight: 700 !important;
}

.payflex-font-extrabold {
    font-weight: 800;
}

.payflex-font-semibold {
    font-weight: 600;
}

.payflex-primary-color {
    color: #002751;
}

.payflex-secondary-color {
    color: #C7A5F9 !important;
}

.payflex-learn-more-both {
    white-space: nowrap;
}

.payflex-widget-wrapper {
    padding: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 600px;
}

.payflex-widget-wrapper p {
    margin-bottom: 0 !important;
    margin-top: 0;
}

.payflex-image-responsive {
    width: 12rem;
}

.payflex-text-title {
    font-size: 18px;
    line-height: 22px;
}

.payflex-text-subtitle {
    font-size: 16px;
    line-height: 20px;
}

.payflex-w-full > .payflex-flex {
    flex-direction: column;
}

.payflex-self-center {
    align-self: center;
}

#payflex-logo {
    max-width: 8rem;
    margin-bottom: 8px;
}

.payflex-ml-4 p,
.payflex-ml-4 a {
    font-size: 12px;
}

#payflexCalculatorWidget a {
    text-decoration: underline !important;
}

#payflexCalculatorWidget img {
    background: none !important;
    padding-top: 2px !important;
    border: none;
    object-fit: contain;
}

@media screen and (max-width: 700px) {
    .payflex-w-full > .payflex-flex {
        flex-direction: column;
        gap: 1.2rem;
    }
}

@media (min-width: 640px) {
    .payflex-w-full > .payflex-flex {
        flex-direction: row;
    }
    #payflex-logo {
        margin-bottom: 0;
    }
}

@media (max-width: 768px) {
    .payflex-image-responsive {
        width: 10rem;
    }
}

@media (max-width: 576px) {
    .payflex-text-title {
        font-size: 0.85rem;
    }
    .payflex-text-subtitle {
        font-size: 0.75rem;
        padding-top: 2px;
        padding-bottom: 2px;
    }
}

@media (max-width: 425px) {
    .payflex-image-responsive {
        width: 8rem;
    }
    .payflex-text-title {
        font-size: 0.85rem;
        line-height: 1.2;
    }
    .payflex-text-subtitle {
        font-size: 0.75rem;
        padding-top: 0;
        padding-bottom: 0;
        line-height: 1.2;
    }
}

@media (max-width: 375px) {
    .payflex-image-responsive {
        width: 4rem;
    }
    .payflex-text-title {
        font-size: 0.65rem;
    }
    .payflex-text-subtitle {
        font-size: 0.55rem;
        padding-top: 0;
        padding-bottom: 0;
    }
    .payflex-ml-4 {
        margin-left: 0.5rem;
    }
}

/* ---- Modal ---- */

#payflex-modal {
    display: none;
    position: fixed;
    z-index: 99999;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
}

#payflex-modal h1,
#payflex-modal h2 {
    padding-bottom: 0 !important;
    border-bottom: none !important;
    margin: 0;
}

.pf-modal-box {
    background-color: #ffffff;
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
    max-width: 900px;
    width: 90%;
    margin: auto;
    overflow-y: auto;
    max-height: 90vh;
}

.pf-modal-header {
    padding: 1rem 1.5rem 0.5rem;
}

.payflex-button-close {
    display: block;
    margin-left: auto;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
}

.payflex-button-close img {
    width: 1.5rem;
    height: 1.5rem;
}

.pf-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.5rem;
    padding-bottom: 0.75rem;
}

.pf-header-logo {
    width: 14rem;
}

.pf-tagline {
    text-align: right;
    font-size: 1rem;
}

.pf-divider {
    border: none;
    border-top: 2px solid #002751;
    margin: 0;
}

.pf-steps {
    padding: 1.5rem;
}

.pf-step {
    display: flex;
    margin-bottom: 1rem;
}

.pf-step-num {
    font-size: 3.25rem;
    font-weight: 700;
    line-height: 1;
    color: #002751;
    padding-right: 1rem;
    min-width: 3.5rem;
    text-align: center;
}

.pf-step-body {
    flex: 1;
}

.pf-step-heading {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
}

.pf-step-desc {
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0 0 0.75rem 0;
    color: #002751;
}

.pf-legal {
    display: flex;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    gap: 1rem;
}

.pf-legal-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    flex: 1;
}

.pf-legal-item img {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    margin-top: 2px;
}

.pf-legal-item span {
    font-size: 0.75rem;
    font-weight: 700;
    color: #002751;
    line-height: 1.3;
}

.pf-footer {
    text-align: center;
    padding: 1rem;
    font-size: 0.75rem;
}

.pf-footer a {
    text-decoration: underline;
    color: #002751;
}

.pf-purple {
    color: #C7A5F9;
}

.pf-navy {
    color: #002751;
}

.pf-bold {
    font-weight: 700;
}

@media (min-width: 531px) and (max-width: 700px) {
    .pf-tagline {
        max-width: 180px;
    }
}

@media (max-width: 530px) {
    #payflex-modal {
        align-items: flex-start;
        background-color: #ffffff;
    }

    .pf-modal-box {
        display: flex;
        flex-direction: column;
        border-radius: 0;
        width: 100%;
        max-width: 100%;
        height: 100vh;
        max-height: 100vh;
        margin: 0;
        box-shadow: none;
        overflow: hidden;
    }

    .pf-steps {
        flex: 1;
        overflow-y: auto;
        min-height: 0;
        overscroll-behavior-y: contain;
    }

    .pf-modal-header {
        padding-top: 1.5rem;
    }

    .pf-header-logo {
        width: 10rem;
        margin-left: -0.5rem;
    }

    .pf-header-row {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.4rem;
    }

    .pf-tagline {
        text-align: left;
        font-size: 0.85rem;
    }

    .payflex-button-close {
        position: fixed;
        top: 0.75rem;
        right: 0.75rem;
        z-index: 100001;
        background: #ffffff;
        border-radius: 50%;
        width: 2.25rem;
        height: 2.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    .pf-legal {
        flex-direction: column;
    }

    .pf-step-num {
        font-size: 2.25rem;
    }
}
</style></head>

