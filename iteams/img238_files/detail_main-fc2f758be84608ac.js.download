98055"\n        aria-hidden="true"\n      />\n    </div>\n    <div>\n      <div class="shipping-intro__freeshipping-title">\n        <span\n          class="shipping-intro__title"\n          v-html="shippingReturnPolicy.title"\n        ></span>\n        <Icon\n          v-if="!newStyle"\n          class="shipping-intro__freeshipping-more"\n          name="sui_icon_doubt_circle_14px_1"\n          color="#999"\n          size="14px"\n          aria-hidden="true"\n        />\n      </div>\n      <div class="shipping-intro__freeshipping-desc">\n        <template v-if="returnPolicySupplyInfo">\n          <span\n            class="gray a11y-focus"\n            role="button"\n            tabindex="0"\n            @click.stop="clickSupplyTip"\n            @keydown.enter.stop="clickSupplyTip"\n            @keydown.space.prevent.stop="clickSupplyTip"\n          >{{ returnPolicySupplyInfo.returnPolicySupplyTip }}</span>\n          <Icon\n            v-if="returnPolicySupplyInfo.returnPolicySupplyUrl"\n            name="sui_icon_more_right_12px_1"\n            size="12px"\n            :is-rotate="serviceVariables.GB_cssRight"\n            aria-hidden="true"\n          />\n        </template>\n      </div>\n    </div>\n    <Icon\n      v-if="newStyle"\n      class="shipping-intro__more-icon"\n      name="sui_icon_more_right_16px_2"\n      size="16px"\n      color="#666666"\n      :is-rotate="serviceVariables.GB_cssRight"\n      aria-hidden="true"\n    />\n  </div>\n</template>\n\n<script>\nimport { Icon, sui_icon_return_48px } from \'@shein-aidc/icon-vue3\'\n\nexport default {\n  name: \'ShippingReturnPolicy\',\n  components: { sui_icon_return_48px, Icon },\n  props: {\n    shippingReturnPolicy: {\n      type: Object,\n      default: () => {\n        title: \'\'\n      }\n    },\n    newStyle: {\n      type: Boolean,\n      default: false\n    },\n    serviceVariables: {\n      type: Object,\n      default: () => ({}),\n    }\n  },\n  computed: {\n    returnPolicySupplyInfo() {\