i_color_link: #2D68A8;@sui_color_note_light_bg: #EFF3F8;@sui_color_flash: #FACF19;@sui_color_guide: #FE3B30;@sui_color_unusual: #BF4123;@sui_color_unusual_bg: #FAF0EE;@sui_color_success: #198055;@sui_color_prompt_unusual: #FFE1DB;@sui_color_prompt_warning: #FFF1D5;@sui_color_prompt_success: #E5F5E6;@sui_color_prompt_common: #D9EAFF;@sui_color_button_stroke_light: #BBBBBB;@sui_color_micro_emphasis: #A86104;@sui_color_micro_emphasis_bg: #FFF8EB;@sui_color_lightgreen: #198055;@sui_color_warning: #EF9B00;@sui_color_black: #000000;@sui_color_black_alpha80: rgba(0,0,0,.8);@sui_color_black_alpha60: rgba(0,0,0,.6);@sui_color_black_alpha30: rgba(0,0,0,.3);@sui_color_black_alpha16: rgba(0,0,0,.16);@sui_color_white: #ffffff;@sui_color_white_alpha80: rgba(255,255,255,.8);@sui_color_white_alpha60: rgba(255,255,255,.6);@sui_color_white_alpha30: rgba(255,255,255,.3);@sui_color_white_alpha96: rgba(255,255,255,.96);@sui_color_gray_dark1: #222222;@sui_color_gray_alpha60: rgba(34,34,34,.6);@sui_color_gray_alpha30: rgba(34,34,34,.3);@sui_color_gray_dark2: #666666;@sui_color_gray_dark3: #767676;@sui_color_gray_light1: #959595;@sui_color_gray_light2: #bbbbbb;@sui_color_gray_light3: #cccccc;@sui_color_gray_weak1: #e5e5e5;@sui_color_gray_weak2: #F6F6F6;@sui_color_gray_weak1a: #F2F2F2;@sui_color_club_rosegold_dark1: #873C00;@sui_color_club_rosegold_dark2: #C96E3F;@sui_color_club_rosegold_dark3: #DA7E50;@sui_color_club_rosegold_dark4: #EAA27E;@sui_color_club_rosegold: #FFBA97;@sui_color_club_rosegold_light1: #FFD8C4;@sui_color_club_rosegold_light2: #FFE2D3;@sui_color_club_gold: #FEECC3;@sui_color_club_black: #161616;@sui_color_club_orange: #FF7F46;\n\n.shipping-guarantee {\n  display: flex;\n  position: relative;\n  &__padding {\n    .padding-l(20px);\n  }\n  &__content {\n    display: flex;\n    flex-direction: column;\n    overflow-x: auto; /* 添加水平滚动 */\n  }\n  &__icon {\n    width: 32px;\n    min-width: 32px;\n    cursor: pointer;\n  }\n  &__labelpage {\n    cursor: default;\n    position: absolute;\n    right: 0;\n    top: 2px;\n    font-size: 12px;\n    font-weight: 400;\n    display: flex;\n    align-items: center;\n    &_dark-bg {\n      margin-right: 8px\n    }\n  }\n  &__content-title_text{\n    cursor: pointer;\n    font-size: inherit;\n    font-weight: inherit;\n    text-transform: none;\n  }\n  &__content-title {\n    font-size: 12px;\n    font-weight: 700;\n    line-height: 1.2;\n    min-height: 24px;\n    display: flex;\n    align-items: center;\n    // margin-bottom: 4px;\n    &_highlight {\n      color: #198055;\n    }\n    // .icon-left, \n    // .icon-right {\n    //   font-size: 12px;\n    //   color: #999;\n    //   cursor: not-allowed;\n    //   display: inline-block;\n    //   transform: unset /* rtl: rotate(0deg) */;\n    //   &.shipping-guarantee__shipactive {  \n    //     color: #000;\n    //     cursor: pointer;\n    //     font-weight: 700;\n    //   }\n    // }\n\n    .svg-icon-left {\n      margin-right: 2px;\n    }\n    .svg-icon-right {\n      margin-left: 2px;\n    }\n    .svg-icon-left, \n    .svg-icon-right {\n      font-size: 12px;\n      color: #999 !important; /* stylelint-disable-line declaration-no-important */\n      cursor: not-allowed;\n      display: inline-block;\n      transform: unset /* rtl: rotate(0deg) */;\n      &.shipping-guarantee__shipactive {  \n        color: #000 !important; /* stylelint-disable-line declaration-no-important */\n        cursor: pointer;\n        font-weight: bold !important; /* stylelint-disable-line declaration-no-important */\n      }\n    }\n  }\n  &__content-items {\n    cursor: pointer;\n    display: flex;\n    overflow-x: auto; /* 添加水平滚动 */\n    scrollbar-width: none;\n    &::-webkit-scrollbar {\n      display: none;\n    }\n    &_highlight {\n      background-color: #F4FAF8;\n      padding-top: 0px;\n      padding-left: 8px; // 当有绿色高亮背景，需要在上下左右加上 padding，绿色图层包裹住 item\n      padding-right: 8px;\n      height: 30px;\n    }\n    &_dark-highlight {\n      background-color: #EEFAF8;\n      padding-left: 8px;\n      padding-right: 8px;\n      margin-right: 8px;\n      height: 30px;\n    }\n  }\n  &__content-column-items {\n    display: flex;\n    flex-direction: column;\n  }\n  &__content-item {\n    display: flex;\n    align-items: center;\n    font-size: 12px;\n    font-weight: 400;\n    line-height: 14px;\n    margin-right: 24px;\n    margin-bottom: 6px;\n    color: @sui_color_gray_dark2;\n    white-space: nowrap;\n    &_compact {\n      margin-right: 12px;\n      &:last-child {\n        margin-right: 0;\n      }\n    }\n    &_has-before::before {\n      color: #666666;\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 4px;\n      background: #198055;\n      border-radius: 4px;\n      margin-right: 4px;\n    }\n  }\n  &__content-items_one-line {\n    .shipping-guarantee__content-item {\n      margin-bottom: 0;\n    }\n  }\n  &__fold-btn {\n    position: absolute;\n    font-weight: normal;\n    right: 0;\n    top: 6px;\n    &_dark-bg {\n      right: 8px\n    }\n  }\n  \n}\n\n.shipping-guarantee-dialog {\n  &__title {\n    font-size: 16px;\n    font-weight: 700;\n  }\n  &__title-segmentation {\n    margin-top: 20px;\n    margin-bottom: 25px;\n    background: #E5E5E5;\n    height: 1px;\n  }\n  &__section {\n    margin-bottom: 24px;\n    font-size: 12px;\n    font-weight: 400;\n    line-height: 1.2;\n    letter-spacing: 0px;\n    text-align: left;\n    color: #666666;\n    & > .link {\n      cursor: pointer;\n      color: #2D68A8;\n      margin-top: 2px;\n      & > span {\n        display: inline-block;\n        margin-bottom: 1px;\n      }\n    }\n    & > .holder-8px {\n      height: 8px;\n    }\n    & > .marginTop8px {\n      margin-top: 8px;\n    }\n  }\n  &__sub-title {\n    font-size: 12px;\n    font-weight: 700;\n    display: flex;\n    align-items: center;\n    color: #000;\n    margin-bottom: 8px;\n\n    &::before {\n      content: '';\n      display: inline-block;\n      width: 4px;\n      height: 4px;\n      background: #198055;\n      border-radius: 4px;\n      margin-right: 4px;\n    }\n  }\n  &__pay-imgs {\n    display: flex;\n    margin-top: 6px;\n    margin-bottom: 8px;\n    & > img {\n      margin-right: 12px;\n      width: 38px;\n      height: 25px;\n    }\n  }\n  &__card-imgs {\n    display: flex;\n    margin-top: 6px;\n    & > img {\n      margin-right: 8px;\n      width: 69px;\n    }\n  }\n  &__contact {\n    display: flex;\n    background: #F6F6F6;\n  }\n  &__contact-item {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 199px;\n    min-height: 90px;\n    border-right: 1px solid #E5E5E5;\n\n\n    & > img {\n      margin-top: 12px;\n      margin-bottom: 8px;\n      width: 30px;\n      height: 30px;\n    }\n\n    & > p {\n      font-size: 12px;\n      font-weight: 400;\n      line-height: 1;\n      color: #767676;\n      width: 92px;\n      text-align: center;\n      @media (prefers-contrast: more) {\n        color: #666;\n      }\n    }\n\n    &:last-child {\n      border-right: none;\n    }\n  }\n}\n.product-intro__freeshipping-more{\n  cursor: pointer;\n}\n.new-shipping-floor{\n  .shipping-intro__new-icon{\n    flex-shrink: 0;\n  }\n  .shipping-guarantee__items-wrapper{\n    display: flex;\n    align-items: center;\n  }\n  .shipping-guarantee__content-item{\n    color: #222;\n  }\n  .shipping-guarantee__new-labelpage{\n    cursor: default;\n    flex-shrink: 0;\n  }\n  .shipping-guarantee__page-icon{\n    cursor: pointer;\n    vertical-align: -2px!important; /* stylelint-disable-line declaration-no-important */\n  }\n  .shipping-guarantee__disabled{\n    cursor: not-allowed;\n    color: #ccc!important; /* stylelint-disable-line declaration-no-important */\n  }\n  .shipping-guarantee__content-title_text{\n    width: 100%;\n    padding-right: 20px;\n    .line-camp(1);\n  }\n  .shipping-intro__more-icon{\n    cursor: pointer;\n  }\n  .shipping-guarantee__selected-icon{\n    margin-right: 2px;\n  }\n}\n",'// Clearfix\n//\n// For modern browsers\n// 1. The space content is one way to avoid an Opera bug when the\n//    contenteditable attribute is included anywhere else in the document.\n//    Otherwise it causes space to appear at the top and bottom of elements\n//    that are clearfixed.\n// 2. The use of `table` rather than `block` is only necessary if using\n//    `:before` to contain the top-margins of child elements.\n//\n// Source: http://nicolasgallagher.com/micro-clearfix-hack/\n\n.clearfix() {\n  &:before,\n  &:after {\n    content: " "; // 1\n    display: table; // 2\n  }\n  &:after {\n    clear: both;\n  }\n}\n\n.fl() {\n    float: left !important; /* stylelint-disable-line declaration-no-important */\n}\n.fr() {\n    float: right !important; /* stylelint-disable-line declaration-no-important */\n}\n.normal-fl(){\n    float: left;\n}\n.normal-fr(){\n    float: right;\n}\n.txt-l() {\n    text-align: left;\n}\n.txt-r() {\n    text-align: right;\n}\n.margin-l(@size) {\n    margin-left: @size;\n}\n.margin-r(@size) {\n    margin-right: @size;\n}\n.padding-l(@size) {\n    padding-left: @size;\n}\n.padding-r(@size) {\n    padding-right: @size;\n}\n.border-l(@size, @color) {\n    border-left: @size solid @color;\n}\n.border-r(@size, @color) {\n    border-right: @size solid @color;\n}\n.border-r-type(@size, @color, @type) {\n    border-right: @size @type @color;\n}\n.transform-origin-l() {\n  transform-origin: left;\n}\n.transform-origin-r() {\n  transform-origin: right;\n}\n.left(@size) {\n    left: @size;\n}\n.right(@size) {\n    right: @size;\n}\n.direction-l() {\n  direction: ltr;\n}\n.direction-r() {\n  direction: rtl;\n}\n.ver-hor-center() {\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n}\n\n.text-overflow() {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n// 多行显示\n.line-camp(@clamp:2) {\n  text-overflow: -o-ellipsis-lastline;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-line-clamp: @clamp;\n  -webkit-box-orient: vertical;\n}\n\n.rational-box(@ratio) {\n    display: inline-block;\n    width: 100%;\n    height: 0;\n    overflow: hidden;\n    padding-bottom: @ratio;\n}\n\n.transition(@prop) {\n  transition: @prop .2s;\n}\n\n.transform-x(@distance) {\n  transform: translateX(@distance);\n}\n\n.transform-rotate(@deg) {\n  transform: rotate(@deg);\n}\n\n.placeholder(@color: @input-color-placeholder) {\n  // Firefox\n  &::-moz-placeholder {\n    color: @color;\n    opacity: 1; // Override Firefox\'s unusual default opacity; see https://github.com/twbs/bootstrap/pull/11526\n  }\n  &:-ms-input-placeholder { color: @color; } // Internet Explorer 10+\n  &::-webkit-input-placeholder  { color: @color; } // Safari and Chrome\n}\n\n// WebKit-style focus\n.tab-focus() {\n  // WebKit-specific. Other browsers will keep their default outline style.\n  // (Initially tried to also force default via `outline: initial`,\n  // but that seems to erroneously remove the outline in Firefox altogether.)\n  & when (@IS_SH) {\n    outline: 2px auto #ccc;\n  }\n  & when (@IS_RW) {\n    outline: none;\n  }\n}\n\n// 平行翻转\n.flip() {\n  transform: rotateY(0deg)\n}\n\n.transform-translate(@sizeX, @sizeY) {\n  transform: translate(@sizeX, @sizeY);\n}\n\n.transform-x-l(@x, @y) {\n  transform: translate(@x, @y);\n}\n\n\n// 左右线性渐变\n.bg-linear-gradient-l(@startColor, @endColor) {\n  background-image: linear-gradient(to left, @startColor, @endColor);\n}\n.bg-linear-gradient-r(@startColor, @endColor) {\n  background-image: linear-gradient(to right, @startColor, @endColor);\n}\n.border-radius-l(@sizeLeftTop,@sizeLeftBottom){\n  border-radius: @sizeLeftTop 0px 0px @sizeLeftBottom;\n}\n.border-radius-r(@sizeRightTop,@sizeRightBottom){\n  border-radius: 0px @sizeRightTop @sizeRightBottom 0px;\n}\n\n.zindex-translatez(@zindex,@translatez){\n  z-index: @zindex;\n  transform: @translatez;\n}\n\n.border-radius-l() {\n  border-radius: 18px 0 0 18px;\n}\n.border-radius-r() {\n  border-radius: 0 18px 18px 0;\n}\n'],sourceRoot:""}]);const a=l},632325:(e,o,i)=>{var t=i(777064);t.__esModule&&(t=t.default),"string"==typeof t&&(t=[[e.id,t,""]]),t.locals&&(e.exports=t.locals);(0,i(474424).A)("e0e87ef0",t,!0,{})},636297:(e,o,i)=>{"use strict";i.d(o,{A:()=>A});var t=i(274061);const n={class:"product-intro__img-attr-group"},r={key:0,class:"product-intro__img-attr-title"},l=["src","alt"],a={key:1,class:"noimg"},s={key:2},_={key:3,class:"desc"};var c=i(448487);const{GB_cssRight:d}=gbCommonInfo,u={name:"PrdImageAttrGroup",components:{Icon:c.A},props:{group:{type:Object,default:()=>({})},parentBoxWidth:{type:Number,default:420}},data:()=>({scrollState:!1,rtl:!!d}),computed:{featureUnit(){const{attrImgList:e=[],attr_name:o="",attr_id:i=""}=this.group,t={name:o||"",nameEn:o||"",nameId:i||"",lines:[],mode:"normal",scrollWidth:0};if(!e.length)return t;const n=e.length;if(n<=3)t.lines.push([...e]);else if(n<6)t.lines.push(e.slice(0,3),e.slice(3));else{const o=Math.ceil(n/2);t.lines.push(e.slice(0,o),e.slice(o)),n>6&&(t.mode="scroll",t.scrollWidth=124*o+2)}return t},attrBarXPos(){const{featureUnit:e,scrollState:o,parentBoxWidth:i}=this,{mode:t="",scrollWidth:n=0}=e;return"scroll"===t&&n&&o?n-i-8:0}},methods:{onAttrScrollBtnClick(e){this.scrollState=!!e,this.$forceUpdate()}}};i(450003);const p=(0,i(196957).A)(u,[["render",function(e,o,i,c,d,u){const p=(0,t.resolveComponent)("Icon");return(0,t.openBlock)(),(0,t.createElementBlock)("div",n,[i.group.attr_name?((0,t.openBlock)(),(0,t.createElementBlock)("div",r,(0,t.toDisplayString)(i.group.attr_name),1)):(0,t.createCommentVNode)("v-if",!0),(0,t.createElementVNode)("div",{class:"horizon-scroll-box product-intro__img-attr-list",style:(0,t.normalizeStyle)({width:u.featureUnit.scrollWidth?`${u.featureUnit.scrollWidth}px`:"unset",transform:`matrix(1, 0, 0, 1, ${d.rtl?"":"-"}${u.attrBarXPos}, 0)`})},[((0,t.openBlock)(!0),(0,t.createElementBlock)(t.Fragment,null,(0,t.renderList)(i.group.attrImgList,((e,o)=>((0,t.openBlock)(),(0,t.c